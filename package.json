{
  "name": "dsh-wan-peers",
  "version": "0.2.0",
  "type": "module",
  "description": "Internet-wide peer discovery and messaging for DeepSeek Harness, via a shared public rendezvous channel (ntfy-compatible) with end-to-end encryption.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "peers",
    "discovery",
    "ntfy"
  ],
  "author": "Myco-Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Myco-Lee/dsh-wan-peers.git"
  },
  "homepage": "https://github.com/Myco-Lee/dsh-wan-peers#readme",
  "bugs": {
    "url": "https://github.com/Myco-Lee/dsh-wan-peers/issues"
  },
  "license": "MIT"
}
